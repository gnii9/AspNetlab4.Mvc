@{
ViewData["Title"] = "Home";
}

<div class="container mt-5">


<div class="text-center">

    <h1 class="display-4 fw-bold">
        Mini Bookstore Management
    </h1>

    <p class="lead text-muted">
        ASP.NET MVC + EF Core + Repository + Service Pattern
    </p>

</div>

<div class="row mt-5">

    <div class="col-md-3">
        <a href="/Books" class="text-decoration-none">
            <div class="card shadow text-center p-4">
                <h3>Books</h3>
                <p>View all Books</p>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="/Genres" class="text-decoration-none">
            <div class="card shadow text-center p-4">
                <h3>Genres</h3>
                <p>One-To-Many relationship</p>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="/Sales/Create" class="text-decoration-none">
            <div class="card shadow text-center p-4">
                <h3>Create Sale</h3>
                <p>Transaction Demo</p>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="/DataHealth" class="text-decoration-none">
            <div class="card shadow text-center p-4">
                <h3>Data Health</h3>
                <p>EF Core Check</p>
            </div>
        </a>
    </div>

</div>


</div>
