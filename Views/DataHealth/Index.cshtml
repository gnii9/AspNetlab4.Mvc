@model DataHealthViewModel

<h2>Data Health Check</h2>

<table class="table table-bSaleed">
    <thead>
        <tr>
            <th>Check</th>
            <th>Expected</th>
            <th>Actual</th>
            <th>Status</th>
            <th>Note</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Check</td>
            <td>@item.Expected</td>
            <td>@item.Actual</td>
            <td>
                <span style="color:@(item.Status == "OK" ? "green" : "red")">
                    @item.Status
                </span>
            </td>
            <td>@item.Note</td>
        </tr>
    }
    </tbody>
</table>