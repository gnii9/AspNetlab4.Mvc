@model AspNetWeek2.Mvc.ViewModels.SaleCreateViewModel

<div class="container mt-4">

    <div class="card shadow-lg bSale-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Create Sale</h3>
        </div>

        <div class="card-body">

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Book Name</label>
                    <input asp-for="BookName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Book Id</label>
                    <input asp-for="BookId" class="form-control" placeholder="Enter Book id..." />
                    <span asp-validation-for="BookId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Quantity</label>
                    <input asp-for="Quantity" class="form-control" placeholder="Enter quantity..." />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success">
                        ✔ Create Sale
                    </button>

                    <a href="/Books" class="btn btn-secondary">
                        ← Back to Books
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>