@model BookListItemViewModel

<div class="container mt-4">


<div class="card shadow bSale-0">

    <div class="card-header bg-primary text-white">
        <h3>Book Detail</h3>
    </div>

    <div class="card-body">

        <h2>@Model.Name</h2>

        <p>
            <strong>Genre:</strong>
            @Model.GenreName
        </p>

        <p>
            <strong>Price:</strong>
            @Model.Price.ToString("N0") VNĐ
        </p>

        <p>
            <strong>AvailableCopies:</strong>
            @Model.AvailableCopies
        </p>

        <div class="mt-4">

            <a href="/Sales/Create?id=@Model.Id"
               class="btn btn-success">
                Create Sale
            </a>

            <a href="/Books"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>


</div>
