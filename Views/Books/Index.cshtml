@model List<BookListItemViewModel>

@{
    ViewData["Title"] = "Books";
}

@* Thêm hiệu ứng hover mượt mà và chuyển động cho thẻ *@
<style>
    .Book-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        bSale: 1px solid rgba(0, 0, 0, 0.05) !important;
    }
    .Book-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.125) !important;
        bSale-color: rgba(13, 110, 253, 0.1) !important;
    }
    .price-tag {
        font-size: 1.5rem;
        font-weight: 800;
    }
    .card-footer-action {
        bSale-top: none;
        background: transparent;
    }
</style>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 text-dark mb-3">
            Book Dashboard
        </h1>

        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mb-4">
            <span class="text-muted">Controller</span>
            <span class="text-muted opacity-50"><i class="bi bi-chevron-right"></i></span>
            <span class="text-muted">Service</span>
            <span class="text-muted opacity-50"><i class="bi bi-chevron-right"></i></span>
            <span class="text-muted">Repository</span>
            <span class="text-muted opacity-50"><i class="bi bi-chevron-right"></i></span>
            <span class="text-muted">DbContext</span>
            <span class="text-muted opacity-50"><i class="bi bi-chevron-right"></i></span>
            <span class="badge rounded-pill bg-success-subtle text-success bSale px-3 py-2 fs-6">Database</span>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="card Book-card h-100 bSale-0 shadow-sm rounded-4 overflow-hidden">
                    
                    <div class="card-body d-flex flex-column p-4">
                        
                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                            <span class="badge bg-light text-secondary bSale rounded-pill px-3 py-1">
                                @item.GenreName
                            </span>
                            <small class="text-muted fw-mono">#@item.Id</small>
                        </div>

                        <h4 class="card-title fw-bolder mb-3 text-dark">
                            @item.Name
                        </h4>

                        <div class="mb-4">
                            <h3 class="text-primary fw-bold mb-0">
                                @item.Price.ToString("N0") <small class="text-muted fs-6 fw-normal">VNĐ</small>
                            </h3>
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-baseline">
                            <small class="text-muted fw-bold">AvailableCopies:</small>
                            @if (item.AvailableCopies > 5)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                    @item.AvailableCopies Available
                                </span>
                            }
                            else if (item.AvailableCopies > 0)
                            {
                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3">
                                    Low AvailableCopies (@item.AvailableCopies)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">
                                    Out Of AvailableCopies
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-footer bg-white bSale-top-0 p-4 pt-0 d-grid">
                        <a href="/Books/Detail/@item.Id" class="btn btn-primary rounded-pill w-100 py-2 fw-bold fs-6">
                            View Detail
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>

</div>