@model BookListItemViewModel

<div class="Book-card">
    <h3>@Model.Name</h3>

    <p class="Book-meta">
        SKU: @Model.Sku
    </p>

    <p class="Book-meta">
        Nhóm: @Model.Genre
    </p>

    <p class="Book-price">
        @($"{Model.Price:N0} VND")
    </p>

    <p>
        Số lượng: <strong>@Model.Quantity</strong>
    </p>

    @if (Model.AvailableCopiesStatus == "Còn hàng")
    {
        <span class="badge badge-success">@Model.AvailableCopiesStatus</span>
    }
    else if (Model.AvailableCopiesStatus == "Cần nhập thêm")
    {
        <span class="badge badge-warning">@Model.AvailableCopiesStatus</span>
    }
    else
    {
        <span class="badge badge-danger">@Model.AvailableCopiesStatus</span>
    }

    <div class="card-actions">
        <a class="btn btn-light"
           asp-controller="Books"
           asp-action="Detail"
           asp-route-id="@Model.Id">
            Xem
        </a>
    </div>
</div>
