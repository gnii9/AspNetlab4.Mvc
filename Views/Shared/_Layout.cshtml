<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


<title>@ViewData["Title"] - Mini Bookstore</title>

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />


</head>

<body>


<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

    <div class="container">

        <a class="navbar-brand fw-bold"
           asp-controller="Home"
           asp-action="Index">

            Mini Bookstore

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse"
             id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Books"
                       asp-action="Index">

                        Books

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Genres"
                       asp-action="Index">

                        Genres

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Sales"
                       asp-action="Create">

                        Create Sale

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="DataHealth"
                       asp-action="Index">

                        Data Health

                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>

<div class="container mt-4">

    @RenderBody()

</div>

<footer class="bSale-top mt-5 py-3 text-center text-muted">

    <div class="container">

        © 2025 Mini Bookstore Management System
        <br />
        ASP.NET MVC + EF Core + Repository + Service Pattern

    </div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)


</body>
</html>
